          <geometry><box><size>4.6 0.1 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.6 0.1 1.0</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
          </material>
        </visual>
